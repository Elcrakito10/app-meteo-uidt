# Copier ce fichier en ".env" (à la racine du projet) et renseigner vos vraies clés.
# Le fichier ".env" ne doit JAMAIS être committé sur GitHub — il est ignoré via .gitignore.

# Clé API OpenWeatherMap — https://openweathermap.org/api
OPENWEATHER_API_KEY=votre_cle_openweather_ici

# Clé API Google Maps (Android) — https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=votre_cle_google_maps_ici
